# Aureon — Root Environment Variables
# Copy to .env for docker-compose

# Application
APP_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Backend
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=sqlite+aiosqlite:///./aureon.db

# Simulation
SIMULATION_TICK_RATE=0.1
SIMULATION_MAX_STEPS=10000

# ML
ML_MODEL_DIR=./models
ML_DEFAULT_CONFIDENCE_THRESHOLD=0.7
