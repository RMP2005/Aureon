# Aureon Backend Environment Variables
# Copy to .env and fill in values

# Application
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./aureon.db

# Simulation
SIMULATION_TICK_RATE=0.1
SIMULATION_MAX_STEPS=10000

# ML
ML_MODEL_DIR=./models
ML_DEFAULT_CONFIDENCE_THRESHOLD=0.7
